# Copy to .env and fill in your Supabase project credentials.
# Get these from Supabase → Project Settings → API.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Optional
# VITE_GOOGLE_MAPS_API_KEY=your-maps-key
# VITE_SENTRY_DSN=https://your-key@o000000.ingest.sentry.io/0000000

# GitHub Actions (Settings → Secrets): add VITE_SUPABASE_URL and
# VITE_SUPABASE_PUBLISHABLE_KEY for dynamic sitemap + prerender in CI.

# Edge function secrets (set in Supabase Dashboard, not in frontend .env):
# OPENAI_API_KEY, LOVABLE_API_KEY, RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET,
# INTERNAL_WEBHOOK_SECRET, ALLOWED_ORIGINS
