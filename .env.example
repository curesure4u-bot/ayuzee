# Ayuzee Environment Variables
# Copy this file to .env and fill in your values

# Supabase (required)
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Messaging and AI endpoints remain disabled previews.
# Private provider tokens belong only in server-side secret storage.
# Never create VITE_ variables for bot tokens or private API keys.

# Sentry Error Tracking (optional — get DSN from sentry.io)
VITE_SENTRY_DSN=https://your-key@o123.ingest.sentry.io/456

# Google Analytics (optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Cloudinary (for file/image uploads — free 25 GB)
VITE_CLOUDINARY_CLOUD_NAME=khcxf5nw
VITE_CLOUDINARY_UPLOAD_PRESET=ayuzee_uploads
