  "policies": [
    {
      "name": "Admin view all orders",
      "check": null,
      "roles": [
        "authenticated"
      ],
      "table": "orders",
      "using": "true",
      "command": "SELECT"
    },
    {
      "name": "Users create orders",
      "check": "(auth.uid() = user_id)",
      "roles": [
        "authenticated"
      ],
      "table": "orders",
      "using": null,
      "command": "INSERT"
    },
    {
      "name": "Users update orders",
      "check": null,
      "roles": [
        "authenticated"
      ],
      "table": "orders",
      "using": "(auth.uid() = user_id)",
      "command": "UPDATE"
    },
    {
      "name": "Users view own orders",
      "check": null,
      "roles": [
        "authenticated"
      ],
      "table": "orders",
      "using": "(auth.uid() = user_id)",
      "command": "SELECT"
    },
    {
      "name": "Products viewable by all",
      "check": null,
      "roles": [
        "public"
      ],
      "table": "products",
      "using": "true",
      "command": "SELECT"
    },
    {
      "name": "Sellers manage own products",
      "check": null,
      "roles": [
        "authenticated"
      ],
      "table": "products",
      "using": "((auth.uid() = seller_id) OR (auth.uid() IS NOT NULL))",
      "command": "ALL"
    }
  ],
  "constraints": [
    {
      "name": "orders_idempotency_key_key",
      "table": "orders",
      "definition": "UNIQUE (idempotency_key)"
    },
    {
      "name": "orders_order_status_check",
      "table": "orders",
      "definition": "CHECK ((order_status = ANY (ARRAY['pending'::text, 'confirmed'::text, 'processing'::text, 'shipped'::text, 'delivered'::text, 'cancelled'::text, 'returned'::text])))"
    },
    {
      "name": "orders_payment_status_check",
      "table": "orders",
      "definition": "CHECK ((payment_status = ANY (ARRAY['unpaid'::text, 'paid'::text, 'refunded'::text, 'failed'::text])))"
    },
    {
      "name": "orders_pkey",
      "table": "orders",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "orders_user_id_fkey",
      "table": "orders",
      "definition": "FOREIGN KEY (user_id) REFERENCES auth.users(id) ON DELETE CASCADE"
    },
    {
      "name": "products_approval_status_check",
      "table": "products",
      "definition": "CHECK ((approval_status = ANY (ARRAY['pending'::text, 'approved'::text, 'rejected'::text])))"
    },
    {
      "name": "products_pkey",
      "table": "products",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "products_seller_id_fkey",
      "table": "products",
      "definition": "FOREIGN KEY (seller_id) REFERENCES auth.users(id) ON DELETE SET NULL"
    }
  ]
